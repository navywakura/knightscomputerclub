# Neon Postgres (https://neon.tech) — free tier OK
# Connection string from Neon dashboard → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# Secret para marcar donantes como VIP (POST /api/admin/vip)
# openssl rand -base64 24
ADMIN_SECRET=change-me-admin-secret-min-12

# Site URL canónica (OAuth redirects + Open Graph absolutos)
NEXT_PUBLIC_SITE_URL=https://knightscomputer.club

# Notificaciones multi-web (packages/web-notify) — id de esta app
# NOTIFY_APP_ID=knightscomputer

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
# Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OAuth — GitHub (https://github.com/settings/developers → OAuth Apps)
# Callback URL: {NEXT_PUBLIC_SITE_URL}/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Donation placeholders (replace with real addresses/links)
NEXT_PUBLIC_PAYPAL_URL=https://paypal.me/PLACEHOLDER
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/PLACEHOLDER
NEXT_PUBLIC_BTC_ADDRESS=bc1qPLACEHOLDER_BITCOIN_ADDRESS
NEXT_PUBLIC_SOL_ADDRESS=PLACEHOLDER_SOLANA_ADDRESS
NEXT_PUBLIC_USDT_ADDRESS=PLACEHOLDER_USDT_TRC20_OR_ERC20
