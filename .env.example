# Neon Postgres (https://neon.tech) — free tier OK
# Connection string from Neon dashboard → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Email OTP (Resend) — OBLIGATORIO en producción ──
# 1) https://resend.com → API Keys → Create
# 2) Domains → Add + verify DNS (SPF/DKIM) de tu dominio
# 3) EMAIL_FROM DEBE ser una casilla de ese dominio (NO onboarding@resend.dev)
#    Formato:  Nodo KCC <noreply@knightscomputer.club>
#    o solo:   noreply@knightscomputer.club
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Nodo KCC <noreply@knightscomputer.club>

# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# Captcha anti-bot (opcional; si falta usa JWT_SECRET)
# openssl rand -base64 24
# CAPTCHA_SECRET=

# ── Giphy GIFs (gratis) — Nexo picker ──
# Tenor API fue descontinuada por Google (2026-06-30).
# 1) https://developers.giphy.com/dashboard/ → Create an App → API Key
# 2) pegar la key (beta free ~100 req/h está bien para un club)
# GIPHY_API_KEY=
# Rating: g | pg | pg-13 | r  (default pg-13)
# GIPHY_RATING=pg-13

# ── Moderación NSFW de imágenes (server-side only) ──
# Mejor opción GRATIS: Google Gemini Flash (vision + free tier)
#   1) https://aistudio.google.com/apikey
#   2) pegar la key abajo en Vercel
# GEMINI_API_KEY=
# Preferí 2.0-flash (estable en free tier). 2.5 a veces vacía la respuesta.
# GEMINI_VISION_MODEL=gemini-2.0-flash
#
# Fallback gratis (opcional): Groq vision
#   https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# Proveedor: auto (default: gemini → groq → xai) | gemini | groq | xai
# NSFW_PROVIDER=auto
#
# Si la API falla o no hay key: open = permitir subida (default, avatar/banner
# funcionan). closed = bloquear hasta que la IA responda.
# NSFW_FAIL_MODE=open
#
# Legacy opcional (pago):
# XAI_API_KEY=
# XAI_VISION_MODEL=grok-4.5

# Secret para marcar donantes como VIP (POST /api/admin/vip)
# openssl rand -base64 24
ADMIN_SECRET=change-me-admin-secret-min-12

# Site URL canónica (Open Graph, sitemap) — preferí www
NEXT_PUBLIC_SITE_URL=https://www.knightscomputer.club

# OAuth SIEMPRE usa www en producción (no localhost).
# Redirect Google Cloud Console (exacto):
#   https://www.knightscomputer.club/api/auth/oauth/google/callback
# OAUTH_SITE_URL=https://www.knightscomputer.club
# Id de mirror (OpenBSD/VPS) para /api/health
# MIRROR_ID=vercel
#
# Cookies: lax (default, OAuth OK) | strict (más CSRF-safe, rompe OAuth cross-site)
# COOKIE_SAMESITE=lax

# Notificaciones multi-web (packages/web-notify) — id de esta app
# NOTIFY_APP_ID=knightscomputer

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
# Redirect URI (exacto):
#   https://www.knightscomputer.club/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# OAuth — GitHub (https://github.com/settings/developers → OAuth Apps)
# Callback URL (exacto):
#   https://www.knightscomputer.club/api/auth/oauth/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Donation placeholders (replace with real addresses/links)
NEXT_PUBLIC_PAYPAL_URL=https://paypal.me/PLACEHOLDER
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/PLACEHOLDER
NEXT_PUBLIC_BTC_ADDRESS=bc1qPLACEHOLDER_BITCOIN_ADDRESS
NEXT_PUBLIC_SOL_ADDRESS=PLACEHOLDER_SOLANA_ADDRESS
NEXT_PUBLIC_USDT_ADDRESS=PLACEHOLDER_USDT_TRC20_OR_ERC20
